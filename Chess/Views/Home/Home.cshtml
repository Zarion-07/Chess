@{
    ViewData["Title"] = "Home";
    ViewData["BodyClass"] = "dark-home";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="~/css/Home.css" />
    <style>
        button {
            color: white;
            background-color: limegreen;
            height: 200px;
            width: 300px;
        }
    </style>

    

</head>
<body>
    <div class="home-container">
        <div id="Bot1">
            <button type="button" onclick="ChooseColor()">Play Bot</button>
        </div>

        <div id="ChooseColor">
            <h2>Choose a color</h2>
            <form asp-controller="Home" asp-action="LichessBot" method="get">
                <button>Black</button>
                <button>White</button>
            </form>
        </div>

    </div>

    @section Scripts {
    <script>
        function ChooseColor() {
            document.getElementById("Bot1").style.display = "none";
            document.getElementById("ChooseColor").style.display = "flex";
        }
    </script>}
</body>
</html>